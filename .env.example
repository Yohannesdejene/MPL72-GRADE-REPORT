# Postgres connection string from Neon (include ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Token you get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Comma-separated list of Telegram numeric user IDs allowed to enter grades
# Get your own ID by messaging @userinfobot on Telegram
ADMIN_TELEGRAM_IDS=111111111,222222222

# Your deployed Render URL (no trailing slash). Leave empty for local polling mode.
WEBHOOK_URL=https://your-app.onrender.com

PORT=3000
